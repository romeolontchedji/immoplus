PGHOST=postgres
PGDATABASE=immoplus
PGUSER=postgres
PGPASSWORD={{POSTGRES_PASSWORD}}
PRIVATE_FILES_KEY={{PRIVATE_FILES_KEY}}
SAUVEGARDE_INTERVALLE_S=86400
SAUVEGARDE_CONSERVER=14
# --- Copie chiffrée hors du serveur (ADR 0008) : laisser RESTIC_REPOSITORY vide pour la désactiver ---
# Dépôt restic chez un AUTRE fournisseur que le VPS, par exemple :
#   Backblaze B2 : s3:https://s3.eu-central-003.backblazeb2.com/immoplus-sauvegardes
#   Cloudflare R2 : s3:https://<compte>.r2.cloudflarestorage.com/immoplus-sauvegardes
RESTIC_REPOSITORY={{RESTIC_REPOSITORY}}
# Clé de chiffrement des sauvegardes (générée) : à garder AUSSI dans le coffre de l'équipe, sinon tout est illisible.
RESTIC_PASSWORD={{RESTIC_PASSWORD}}
# Identifiants d'accès au stockage S3 (créés chez le fournisseur, droits limités à ce seul compartiment).
AWS_ACCESS_KEY_ID={{SAUVEGARDE_CLE_ACCES}}
AWS_SECRET_ACCESS_KEY={{SAUVEGARDE_CLE_SECRETE}}
