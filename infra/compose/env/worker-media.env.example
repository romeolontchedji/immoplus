# Aucun accès à Internet (réseau interne) ; ne monte que media_tmp et media_public.
SECRET_KEY={{SITE_SECRET_KEY}}
DOMAIN={{DOMAIN}}
DB_HOST=postgres
DB_NAME=immoplus
DB_USER=app
DB_PASSWORD={{APP_DB_PASSWORD}}
DB_STATEMENT_TIMEOUT_MS=60000
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/1
# Destinataires des alertes d'erreurs
ERREURS_DESTINATAIRES={{ERREURS_DESTINATAIRES}}
