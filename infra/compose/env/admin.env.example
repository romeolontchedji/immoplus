# Clé, rôle PostgreSQL et clé des pièces d'identité propres à l'administration.
SECRET_KEY={{ADMIN_SECRET_KEY}}
PRIVATE_FILES_KEY={{PRIVATE_FILES_KEY}}
DOMAIN={{DOMAIN}}
ADMIN_ALLOWED_IPS={{ADMIN_ALLOWED_IPS}}
DB_HOST=postgres
DB_NAME=logeo
DB_USER=admin_app
DB_PASSWORD={{ADMIN_DB_PASSWORD}}
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/1
