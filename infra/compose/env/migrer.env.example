# Seul processus qui exécute le DDL : rôle `migrate`.
SECRET_KEY={{SITE_SECRET_KEY}}
DB_HOST=postgres
DB_NAME=logeo
DB_USER=migrate
DB_PASSWORD={{MIGRATE_DB_PASSWORD}}
DB_STATEMENT_TIMEOUT_MS=0
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/1
DJANGO_SETTINGS_MODULE=config.settings.migrer
