SECRET_KEY={{SITE_SECRET_KEY}}
JWT_SIGNING_KEY={{JWT_SIGNING_KEY}}
DOMAIN={{DOMAIN}}
DB_HOST=postgres
DB_NAME=immoplus
DB_USER=app
DB_PASSWORD={{APP_DB_PASSWORD}}
DB_STATEMENT_TIMEOUT_MS=5000
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/1
SMS_PROVIDER={{SMS_PROVIDER}}
SMS_HTTP_URL={{SMS_HTTP_URL}}
SMS_HTTP_TOKEN={{SMS_HTTP_TOKEN}}
SMS_HTTP_SECRET={{SMS_HTTP_SECRET}}
PUSH_PROVIDER={{PUSH_PROVIDER}}
SUBSCRIPTION_ENABLED=false
LOG_LEVEL=INFO
# Anti-robot du site (Cloudflare Turnstile)
CAPTCHA_PROVIDER={{CAPTCHA_PROVIDER}}
TURNSTILE_SITE_KEY={{TURNSTILE_SITE_KEY}}
TURNSTILE_SECRET={{TURNSTILE_SECRET}}
# Destinataires des alertes d'erreurs
ERREURS_DESTINATAIRES={{ERREURS_DESTINATAIRES}}
