SECRET_KEY={{SITE_SECRET_KEY}}
JWT_SIGNING_KEY={{JWT_SIGNING_KEY}}
DOMAIN={{DOMAIN}}
DB_HOST=postgres
DB_NAME=immoplus
DB_USER=app
DB_PASSWORD={{APP_DB_PASSWORD}}
DB_STATEMENT_TIMEOUT_MS=60000
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/1
PUSH_PROVIDER={{PUSH_PROVIDER}}
CELERY_CONCURRENCY=4
# Fournisseur anti-robot (exigé par les réglages de production)
CAPTCHA_PROVIDER={{CAPTCHA_PROVIDER}}
# Courriels : seul le worker envoie (codes de l'administration, alertes d'erreurs)
EMAIL_BACKEND={{EMAIL_BACKEND}}
EMAIL_HOST={{EMAIL_HOST}}
EMAIL_PORT={{EMAIL_PORT}}
EMAIL_HOST_USER={{EMAIL_HOST_USER}}
EMAIL_HOST_PASSWORD={{EMAIL_HOST_PASSWORD}}
EMAIL_USE_TLS={{EMAIL_USE_TLS}}
EMAIL_USE_SSL={{EMAIL_USE_SSL}}
DEFAULT_FROM_EMAIL={{DEFAULT_FROM_EMAIL}}
ERREURS_DESTINATAIRES={{ERREURS_DESTINATAIRES}}
# Cloudinary (ADR 0010) : seul le worker envoie et supprime des fichiers
CLOUDINARY_CLOUD_NAME={{CLOUDINARY_CLOUD_NAME}}
CLOUDINARY_API_KEY={{CLOUDINARY_API_KEY}}
CLOUDINARY_API_SECRET={{CLOUDINARY_API_SECRET}}
CLOUDINARY_FOLDER={{CLOUDINARY_FOLDER}}
