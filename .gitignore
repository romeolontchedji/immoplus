*.py[cod]
*.egg-info/
.eggs/
*.so
build/
venv/

# Environnement virtuel
.venv/

# Environnement réel : seuls les .env.example sont versionnés
.env
.env.*
!.env.example
infra/compose/env/*.env

# Caches et outils de contrôle
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

