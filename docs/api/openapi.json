    "components": {
        "schemas": {
            "ActivationIn": {
                "type": "object",
                "properties": {
                    "platform": {
                        "$ref": "#/components/schemas/PlatformEnum"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "otp_token": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "terms_accepted": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "otp_token",
                    "password",
                    "platform",
                    "terms_accepted"
                ]
            },
            "AppareilOut": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "label": {
                        "type": "string",
                        "nullable": true
                    },
                    "platform": {
                        "type": "string"
                    },
                    "app_version": {
                        "type": "string",
                        "nullable": true
                    },
                    "last_seen_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "current": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "app_version",
                    "created_at",
                    "current",
                    "id",
                    "label",
                    "last_seen_at",
                    "platform"
                ]
            },
            "ChangementMotDePasseIn": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "new_password": {
                        "type": "string",
                        "maxLength": 128
                    }
                },
                "required": [
                    "current_password",
                    "new_password"
                ]
            },
            "ChangementNumeroIn": {
                "type": "object",
                "properties": {
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "otp_token": {
                        "type": "string",
                        "maxLength": 2048
                    }
                },
                "required": [
                    "otp_token",
                    "password"
                ]
            },
            "ConnexionIn": {
                "type": "object",
                "properties": {
                    "platform": {
                        "$ref": "#/components/schemas/PlatformEnum"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    }
                },
                "required": [
                    "password",
                    "phone",
                    "platform"
                ]
            },
            "InscriptionIn": {
                "type": "object",
                "properties": {
                    "platform": {
                        "$ref": "#/components/schemas/PlatformEnum"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "otp_token": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "full_name": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "terms_accepted": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "full_name",
                    "otp_token",
                    "password",
                    "platform",
                    "terms_accepted"
                ]
            },
            "JetonPushIn": {
                "type": "object",
                "properties": {
                    "provider": {
                        "type": "string",
                        "maxLength": 8
                    },
                    "token": {
                        "type": "string",
                        "maxLength": 4096
                    }
                },
                "required": [
                    "provider",
                    "token"
                ]
            },
            "JetonsOut": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string"
                    },
                    "refresh": {
                        "type": "string"
                    },
                    "expires_in": {
                        "type": "integer"
                    }
                },
                "required": [
                    "access",
                    "expires_in",
                    "refresh"
                ]
            },
            "MotDePasseOublieIn": {
                "type": "object",
                "properties": {
                    "otp_token": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "new_password": {
                        "type": "string",
                        "maxLength": 128
                    }
                },
                "required": [
                    "new_password",
                    "otp_token"
                ]
            },
            "OtpDemandeIn": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "purpose": {
                        "$ref": "#/components/schemas/PurposeEnum"
                    },
                    "attestation_token": {
                        "type": "string",
                        "maxLength": 4096
                    }
                },
                "required": [
                    "phone",
                    "purpose"
                ]
            },
            "OtpDemandeOut": {
                "type": "object",
                "properties": {
                    "resend_after_s": {
                        "type": "integer"
                    }
                },
                "required": [
                    "resend_after_s"
                ]
            },
            "OtpJetonOut": {
                "type": "object",
                "properties": {
                    "otp_token": {
                        "type": "string"
                    },
                    "expires_in": {
                        "type": "integer"
                    }
                },
                "required": [
                    "expires_in",
                    "otp_token"
                ]
            },
            "OtpVerificationIn": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "purpose": {
                        "$ref": "#/components/schemas/PurposeEnum"
                    },
                    "code": {
                        "type": "string",
                        "maxLength": 12
                    }
                },
                "required": [
                    "code",
                    "phone",
                    "purpose"
                ]
            },
            "PatchedProfilIn": {
                "type": "object",
                "properties": {
                    "full_name": {
                        "type": "string",
                        "maxLength": 200
                    }
                }
            },
            "PlatformEnum": {
                "enum": [
                    "android",
                    "ios",
                    "web"
                ],
                "type": "string",
                "description": "* `android` - android\n* `ios` - ios\n* `web` - web"
            },
            "PurposeEnum": {
                "enum": [
                    "signup",
                    "reset_password",
